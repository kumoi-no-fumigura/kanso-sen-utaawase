 "poems": [
  {
   "seq": "1",
   "text": "鳴むしのこゑの色にはあらねともうきはみにしむ秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "さならてもなけかぬ時のあり顔に秋とやわきて物のかなしき",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "とふ人もあらしと思ふを三輪の山いかにまちみむ秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "かくはかり月を哀となかめすはいかに久しき秋のよならん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "山里は嶺のあらしの絕す吹音をともにて月をみるかな",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "物思ふ袖のみぬらす時雨哉よもの木の葉はなとかそむらん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "月宿るをしまのとまやとふ人にみせはやと社あまもいふらめ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "哀にもめならふ色の草はみなかれての後に匂ふしらきく",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "詠むるにぬるゝ袂をうらみても身のとかならぬ秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "我ためとことさらに社わけすとも降つむ雪の上をたにとへ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "跡おしむたかならはしの山ちとて積れる雪をとふ人のなき",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "誰もみに積りて年の暮行は人の上さへけふはかなしき",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "をのつからとひこん人を思ひやる道もかなしく積る雪かな",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "たのめしは今宵もいかになりぬらむ更ぬるものを山のはの月",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "過來つる何の名殘のおしさにか暮れ行年を猶したふらん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "たくひなき思ひの程もみえなましあさまの山の煙たゝすは",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "人しれぬ涙の色はかひもなしみせはやとたに思ひよはらは",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "おきて行人は待ける鳥の音をなとあやにくに我いとふらん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "をのか音につらき別のありとたに思ひしらてや鳥のなくらん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "夜さむなる哀有明の月影にいかにせむとかをき別るらん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "あさき瀨やはしめなりけむ飛鳥川思ひそめてそ淵と成ける",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "うたゝねにみ習ひにける夢をさへみもはてさせぬ夜はの風哉",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "思ひねのなみだなそへそよはの月曇るといはゝ人も社しれ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "いつまてかたのめし事を命とも慰むほとゝ人にこひけむ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "僞と思ひとられぬゆふへ社はかなきものゝかなしかりけれ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "逢みけむ契そつらきよそにてはうしとも人の思はれやせし",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "有明の月はかたみとだのまれす暮まつまてのみにもそはねは",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "たくひなくほさぬ袖哉草も木も露うち拂ふかせはあるよに",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "こひしなはまよはむ闇を思ふにも月はしはしのかたみ成けり",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "たのみける心ならては今更につらき物とも誰をうらみむ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "色に出て袖のよそめはふりけてぬいかにをさへし涙なるらん",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "俤をうき身にそへて戀しなは後のよまてのつらさをやみん",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "何とかは賴みわたらん吉野河はやくみえにし人のうきよを",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "ひと筋に身をうき物と思ふ社人のつらさのあまり成けれ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "跡絕て人こぬ宿のさひしさはもとめぬ山の奥かとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "すむあまも哀はしるや煙たつをのかしほやの夕くれの空",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "こひはよの常なりけれとみな人のみに始めてはさそな悲しき",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "さらぬたに夕暮つらき山里にとふ人かへる岩のかけはし",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "いかにして夢をさまさむ人のよに又むまるへき身とも賴ます",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "久かたの天つみ空の朝霞たち社わたれ春やきぬらん",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "きてみすと人も恨みしいつくにもかく社花は盛りなるらめ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "みる人のうきにはよらぬ春の空かすめは月そおほろなりける",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "をのつから移ふ花に人とはゝすまの浦風わふとこたへよ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "いかにせむさならぬ事も思ふみにまして別の春の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "ありてよのはてしうけれは花の爲うしろやすくそ風は吹ける",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "はかなしな我心なる槇の戶をさゝぬたのみに人はまたるゝ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "身をなけく心に道はなき物をいつちいかにと思ひなるらん",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "山里は淋しきものとしりにけりきゝてもいとへ嶺の松風",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "よそにては思ふ計にみゆるかとうきみの上を人にとはゝや",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "草かれと思はゝみにもつみてましよそなる物はわかなんけり",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "よは春と誰もしるらし鶯のなきゝかせたる今朝の初音に",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "吹かせをいはゝいはなむ櫻花散かふ時のはるの山もり",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "春かさてやみにしみをそ思ひしる霞める月のよはの哀に",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "きてもみぬ故〓人のをそ櫻散殘れりと猶や告まし",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "いとせめて物うく成ぬを鹿鳴山里いかて秋をすくさむ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "思ふよりいとゝいく野の道遠みまたふみも見す積る雪かな",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "磯のかみふるの山への秋の月いつれのよにかすみはしめけむ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "とふ人のなきほとみゆる故〓の庭の白雪いく重なるらん",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "いつとなき松の風さへ秋のよは寐覺すれはやみにはしむらん",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "しらせはやとはかり物を思ふ社ならはぬ戀のはしめ也けれ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "けふも猶いかにそめんとしくるらん早紅葉にし山の木のはを",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "煙たつ空にもしるや富士のれのもえつゝとはに思ひ有とは",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "わひ人の涙とゝもに神無月まなくしくるゝ空はいかにと",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "我戀はなたかの浦のなひきもの心はよれとあふよしもなし",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "さひしさはよそにてもしれ朝夕にたく冬柴の煙りけふらす",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "こひせしと月にやゝかてちかはまし曇る淚のうきにつけても",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "さゆれともこほらぬものか水鳥のうかふの池の曉の空",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "待やする我やゆかむと思ふまにはるかにさ夜の更にける哉",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "過きつる月日のはての報ひとてまたそことしもけふに成ぬる",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "せめて猶したにはなひけ夕煙もえて我名の空にたゝすは",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "いかなれはさても心の慰まて逢夜も袖のあやにぬるらむ",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "秋風はいたくな吹そ今はとてこさらむ後の夕暮もうし",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "いかにせむよもとは思ふ夕くれの秋風吹は人そまたるゝ",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "一こゑは聞もかくしつ曉のわかれはあまり鳥そ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "今はたゝさらぬ別になしはてゝまた逢みむとまたれすも哉",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "あすしらぬ命に人をとひわひて秋の夜なかく思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "戀しきをとてもかくても慰むる心のなとかみになかるらむ",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "むは玉の夢はさめぬる床の上に猶佛のみえもするかな",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "をのつから年月へなはこひしさの限りありやと思ふ計そ",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "をさふへき袖は昔に朽はてめ我くろかみよ涙もらすな",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "こすはこす猶も賴まむ忘るとも忘れはてめと我にきかすな",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "忍ふるにひとり〓〓かあらはさは誰をたれとはいひも隱さむ",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "心かへする世なりとも人はこひ我つらからはさてもかひなし",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "山のはに夜更て出る月よりもまち遠になるみの契りかな",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "かきりそと別れし時にいはぬ社おもへは人のなさけなりけれ",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "こひ人の心は遠く成にけりわする計の月日ならねと",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "かくてよにあらはやとしも思はぬにそむきはてぬは何の心そ",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "わすられぬ物からつらき年月はいかなる中のへたてなろらん",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "よのつねと思へはいとゝうき事のやるかたもなく歎かるゝ哉",
   "kana": "",
   "speaker": "",
   "page": 518,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
